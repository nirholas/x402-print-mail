                        "addressState": {
                          "type": "string"
                        },
                        "addressZip": {
                          "type": "string"
                        },
                        "addressCountry": {
                          "type": "string"
                        }
                      }
                    },
                    "pageCount": {
                      "type": "integer"
                    },
                    "color": {
                      "type": "boolean"
                    },
                    "doubleSided": {
                      "type": "boolean"
                    },
                    "previewFormat": {
                      "type": "string"
                    },
                    "previewPdfBase64": {
                      "type": "string"
                    },
                    "previewUrl": {
                      "type": [
                        "null",
